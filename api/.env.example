# Neon Postgres connection string from the Neon console.
# Use the pooled URI if available. sslmode=require is appended automatically if missing.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Long random string used to sign access tokens. Rotate if leaked.
JWT_SECRET_KEY=replace-with-a-long-random-secret

JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated dashboard origins allowed to call the authenticated API.
CORS_ORIGINS=http://localhost:3000

# Public API URL for Connect docs and customer websites.
# Leave empty to use the host the request reached (localhost in development).
# After deploy, set this to your public API, e.g. https://api.example.com
PUBLIC_API_URL=

# Amazon S3 for original support documents. Objects stay private.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=
S3_PRESIGN_EXPIRES_SECONDS=300

# Pinecone for per-business vector search. Queries always filter by business_id.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=support-dock
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# OpenAI embeddings used before vectors are stored in Pinecone.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=512
OPENAI_CHAT_MODEL=gpt-4o-mini

# development enables retrieval logs (question language, translated queries, scores).
APP_ENV=development

# Resend for support-ticket emails to the business team.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Support Dock <beth.t@example.com>
